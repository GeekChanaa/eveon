# Build context of the API image (see Dockerfile). Only what `dotnet publish` needs goes in.

# Build output and local state
bin/
obj/
publish/
out/
logs/
**/*.log
TestResults/
App_Data/
.vs/
.vscode/
.idea/
*.tar.gz
*.zip
*.pdf
*.bak

# Never send secrets, environment files or environment specific settings to the build context:
# production values come from environment variables at run time.
*.env
.env*
secrets.json
*.pem
*.pfx
*.key
appsettings.Development.json
appsettings.development.json
appsettings.Production.json
appsettings.production.json
appsettings.*.local.json

# sql-scripts/ is git-ignored and may hold database dumps: only the reference data the first setup
# job imports (Services/Setup/FirstSetupJob.cs) may go in.
sql-scripts/*
!sql-scripts/EV-cars.csv
!sql-scripts/charger-brands.json

# Deployment files and docs are not part of the application
deploy/
deploy.sh
railway.json
Dockerfile
.dockerignore
*.md
