{
  "AppSettings": {
    // Secrets (Token, connection string, passwords, keys) are never stored here: use
    // `dotnet user-secrets` locally and environment variables in production (see docs/configuration.md).
    "Issuer": "eveon-api",
    "Audience": "eveon-clients",
    "Token": ""
  },
  "AuthTokens": {
    // Access tokens are short lived; the refresh token below carries the session.
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30,
    // true: every refresh restarts the 30 day window, so an active user stays signed in.
    "SlidingExpiration": true,
    "CleanupRetentionDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AwsSns": {
    "AccessKey": "",
    "SecretKey": "",
    "Region": "eu-west-1",
    "TopicArn": "arn:aws:iam::209479293831:user/sns-publisher"
  },
  "Serilog": {
    // Destinations live here, not in code: adding a provider later means adding its
    // package and one more entry under "WriteTo" (for example
    // { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }).
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        // Plain text, one file per day. Everything a line needs to be readable on its
        // own is in the template, including the correlation id set by
        // RequestContextLoggingMiddleware.
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "flushToDiskInterval": "00:00:02",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] [{SourceContext}] (user:{UserID}) {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        // Errors kept apart so an incident does not have to be dug out of the full log.
        // restrictedToMinimumLevel does the filtering, which keeps this sink dependency
        // free (an expression filter would pull in Serilog.Expressions).
        "Name": "File",
        "Args": {
          "path": "logs/errors-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "shared": true,
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] [{SourceContext}] (user:{UserID}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "VoltaXApi"
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "770332888786-t0gu045nejjna36sc152835m2jb6pbjv.apps.googleusercontent.com",
      "ClientSecret": "",
      // Must match an "Authorized redirect URI" of the OAuth client, as <api base url> + this path
      "CallbackPath": "/signin-google",
      // Extra OAuth client ids (android / ios / desktop) accepted by POST /api/auth/google
      "AdditionalClientIds": []
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  // Semicolon separated host names the API answers to, e.g. "api.eveon.ma".
  "AllowedHosts": "",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "MailSettings": {
    "Mail": "test@voltaxcharging.com",
    "Host": "smtp.titan.email",
    "Port": 587,
    "Password": ""
  },
  "SocialLinks" : {
    "instagram" : "https://www.instagram.com",
    "facebook" : "https://www.facebook.com",
    "twitter" : "https://www.twitter.com",
    "linkedin" : "https://www.linkedin.com"
  },
  "GlobalConfigurations": {
