# Copy to /etc/eveon/api.env on the server (chmod 600, owned by root) and fill in.
# Never commit the real file. Nested settings use __ instead of : .

ASPNETCORE_ENVIRONMENT=Production

# Host name(s) the API answers to, and the dashboard origin(s) allowed by CORS.
AllowedHosts=api.eveon.ma
Cors__AllowedOrigins__0=https://app.eveon.ma
# Address of the reverse proxy allowed to set X-Forwarded-* (Caddy on the host via docker bridge).
ReverseProxy__KnownProxies__0=172.17.0.1

# JWT signing key: at least 64 random characters, e.g. `openssl rand -base64 64`.
AppSettings__Token=
AppSettings__Issuer=eveon-api
AppSettings__Audience=eveon-clients

ConnectionStrings__DefaultConnection=

Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

MailSettings__Mail=
MailSettings__Password=

AwsSns__AccessKey=
AwsSns__SecretKey=
AwsSns__Region=eu-west-1
AwsSns__TopicArn=

SpaLink=https://app.eveon.ma/

# OCPP security profiles / charger PKI (docs/configuration.md). Profile 1 over plain ws:// is refused unless:
# Ocpp__AllowInsecureProfile1=false
# Security profile 3 behind Caddy (deploy/Caddyfile.mtls): header with the client certificate, trusted only from KnownProxies.
# Ocpp__Tls__ClientCertHeader=X-Client-Cert
# Charger CA (base64 of the PEM files). Never use Pki__AutoCreateDevCa in production.
# Pki__CaCertificatePem=
# Pki__CaPrivateKeyPem=
# Pki__ChargerCertificateDays=365
# Pki__RenewBeforeDays=30
