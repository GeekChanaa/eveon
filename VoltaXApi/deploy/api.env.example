# Copy to deploy/api.env (gitignored) and fill in: deploy-ec2.sh uploads it to /etc/eveon/api.env on the host
# (chmod 600). On another Docker host, copy it there by hand. Never commit the real file.
# Nested settings use __ instead of : .

ASPNETCORE_ENVIRONMENT=Production

# Host name(s) the API answers to, and the dashboard origin(s) allowed by CORS.
AllowedHosts=api.eveon.ma
Cors__AllowedOrigins__0=https://app.eveon.ma
# Address of the reverse proxy allowed to set X-Forwarded-* (Caddy on the host via docker bridge).
ReverseProxy__KnownProxies__0=172.17.0.1

# JWT signing key: at least 64 random characters, e.g. `openssl rand -base64 64`.
AppSettings__Token=
AppSettings__Issuer=eveon-api
AppSettings__Audience=eveon-clients

# Keep the pool options: Hostinger allows 500 new connections per hour per database user, and without
# MinimumPoolSize the background workers reconnect each time the pool has emptied.
# Server=<host>;Port=3306;Database=<db>;User=<user>;Password=<password>;SslMode=Preferred;Pooling=true;MinimumPoolSize=2;MaximumPoolSize=20;ConnectionIdleTimeout=600
ConnectionStrings__DefaultConnection=

Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# SMTP of the eveon.ma mailboxes (Titan, Hostinger's email): port 465 is TLS from the first byte.
MailSettings__Host=smtp.titan.email
MailSettings__Port=465
MailSettings__Mail=no-reply@eveon.ma
MailSettings__DisplayName=EVEON
# SMTP login when it differs from the sender address; empty = MailSettings__Mail.
MailSettings__Username=
# The mailbox password (hPanel > Emails > the mailbox).
MailSettings__Password=

# SMS through AWS SNS: a least-privilege IAM user (sns:Publish only).
AwsSns__Region=eu-west-1
AwsSns__TopicArn=
AwsSns__AccessKey=
AwsSns__SecretKey=
# (keep a comment after an empty secret: secret scanners read the next line as its value)

SpaLink=https://app.eveon.ma/
# Where emails (verify email, reset password) and Google sign in send people: the eveon-ui site.
AuthLink=https://eveon.ma/

# The image carries appsettings.json only (development defaults): every production value that differs
# from it is set here, since appsettings.production.json is no longer copied into the image.
SupportEmails__support=support@voltaxcharging.com
SupportEmails__admin=support@voltaxcharging.com
# Apply pending migrations on start instead of deploy.sh's --migrate step (single instance only).
# Database__MigrateOnStartup=true

# OCPP security profiles / charger PKI (docs/configuration.md). Profile 1 over plain ws:// is refused unless:
# Ocpp__AllowInsecureProfile1=false
# Security profile 3 behind Caddy (deploy/Caddyfile.mtls): header with the client certificate, trusted only from KnownProxies.
# Ocpp__Tls__ClientCertHeader=X-Client-Cert
# Charger CA (base64 of the PEM files). Never use Pki__AutoCreateDevCa in production.
# Pki__CaCertificatePem=
# Pki__CaPrivateKeyPem=
# Pki__ChargerCertificateDays=365
# Pki__RenewBeforeDays=30
