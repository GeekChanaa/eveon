# Railway service variables for the API (Service > Variables > Raw Editor, paste and fill in).
# Never commit the filled-in values. Nested settings use __ instead of : .

ASPNETCORE_ENVIRONMENT=Production

# Host names the API answers to. healthcheck.railway.app is the host Railway's health probe sends;
# *.up.railway.app keeps the generated Railway domain usable for debugging.
AllowedHosts=api.eveon.ma;api-v2.eveon.ma;healthcheck.railway.app;*.up.railway.app
Cors__AllowedOrigins__0=https://dashboard.eveon.ma
Cors__AllowedOrigins__1=https://dashboard-v2.eveon.ma
# Public site (eveon-ui) that hosts the sign in / sign up pages and calls the API from the browser.
Cors__AllowedOrigins__2=https://eveon.ma
Cors__AllowedOrigins__3=https://www.eveon.ma
# Railway's edge proxy terminates TLS and has no fixed address.
ReverseProxy__TrustAllProxies=true

# Hostinger MySQL / MariaDB. Host from hPanel > Databases > Remote MySQL (e.g. srvXXXX.hstgr.io).
Database__Provider=MySql
Database__ServerVersion=11.8.9
# Railway has one instance and no pre-deploy step here: apply pending migrations on start (docs/database.md).
Database__MigrateOnStartup=true
ConnectionStrings__DefaultConnection=Server=<srvXXXX>.hstgr.io;Port=3306;Database=<database>;User=<user>;Password=<password>;SslMode=Preferred;

# JWT signing key: at least 64 random characters, e.g. `openssl rand -base64 64`.
AppSettings__Token=
AppSettings__Issuer=eveon-api
AppSettings__Audience=eveon-clients

# Required: with an empty ClientSecret every request fails with 500 (Google OAuth options validation).
Authentication__Google__ClientId=770332888786-t0gu045nejjna36sc152835m2jb6pbjv.apps.googleusercontent.com
Authentication__Google__ClientSecret=

# Railway blocks outbound SMTP (ports 25, 465, 587 and 2525) on the Free, Trial and Hobby plans: send through
# Brevo's HTTPS API instead (free, 300 mails/day). BrevoApiKey = an API key (Brevo > SMTP & API > API keys,
# xkeysib-...), not the SMTP key; Mail = a sender verified in Brevo. With the key set, Host / Port / Username /
# Password are unused. On the Pro plan SMTP works too: leave BrevoApiKey empty and fill the SMTP lines.
MailSettings__BrevoApiKey=
MailSettings__Mail=no-reply@eveon.ma
MailSettings__Host=smtp-relay.brevo.com
MailSettings__Port=587
MailSettings__Username=
MailSettings__Password=

# SMS through AWS SNS: a least-privilege IAM user (sns:Publish only).
AwsSns__Region=eu-west-1
AwsSns__TopicArn=
AwsSns__AccessKey=
AwsSns__SecretKey=
# (keep a comment after an empty secret: secret scanners read the next line as its value)

SpaLink=https://dashboard-v2.eveon.ma/
# Where emails (verify email, reset password) and Google sign in send people: the eveon-ui site.
AuthLink=https://eveon.ma/

# The image carries appsettings.json only (development defaults): every production value that differs
# from it is set here, since appsettings.production.json is no longer copied into the image.
SupportEmails__support=support@voltaxcharging.com
SupportEmails__admin=support@voltaxcharging.com

# First setup check, runs on every start (see Services/Setup/FirstSetupJob.cs). Defaults live in
# appsettings.production.json; override only what you need. The test accounts admin@, partner@ and
# customer@eveon.ma get new passwords on every start, mailed to the recipient below (needs MailSettings).
# Set FirstSetup__TestUsers__Enabled=false once real accounts exist.
# FirstSetup__TestUsers__Enabled=true
# FirstSetup__TestUsers__CredentialsRecipient=chanaa.projects@gmail.com
# FirstSetup__FailStartupOnError=false
